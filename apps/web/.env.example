# Base URL of the Sentinel control-plane API (apps/api).
# Exposed to the browser, so it must be the URL the browser can reach.
NEXT_PUBLIC_API_BASE=http://localhost:8000

# Optional URL prefix the dashboard is served under (build time). Leave empty
# for local dev; production behind the shared proxy uses /security, with
# NEXT_PUBLIC_API_BASE=/security/api (same origin, so no CORS needed).
NEXT_PUBLIC_BASE_PATH=
