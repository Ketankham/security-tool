# --- Control plane ---
ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=change-me-in-real-envs

# --- Postgres ---
DATABASE_URL=postgresql+asyncpg://sentinel:sentinel@localhost:5432/sentinel
DATABASE_URL_SYNC=postgresql+psycopg://sentinel:sentinel@localhost:5432/sentinel

# --- Redis (Celery broker/backend + rate limiter) ---
REDIS_URL=redis://localhost:6379/0

# --- Object storage (transcripts/HAR/screenshots). R2 is S3-compatible. ---
# Must be the same values in both the API's and worker's .env — they read
# and write the same physical location.
STORAGE_BACKEND=local          # local | s3
STORAGE_LOCAL_PATH=./data/transcripts
REPORT_LOCAL_PATH=./data/reports
S3_ENDPOINT_URL=
S3_BUCKET=sentinel-transcripts
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# --- Quick-scan (POST /quick-scan) ---
# Bypasses ownership verification + persona setup for a bare URL. Off by
# default: this is a local/dev convenience, never a customer-facing
# deployment default — see apps/api/sentinel_api_app/routers/quick_scan.py.
ENABLE_QUICK_SCAN=false

# --- Credential envelope encryption ---
# Per-org data keys are wrapped with this master key. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
KMS_MASTER_KEY=

# --- AI provider ---
ANTHROPIC_API_KEY=
LLM_MODEL_HIGH=claude-opus-5
LLM_MODEL_MID=claude-sonnet-5
LLM_MODEL_LOW=claude-haiku-4-5-20251001
LLM_PER_SCAN_TOKEN_BUDGET=200000

# --- Auth (control plane, Clerk in production) ---
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# --- Billing ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Out-of-band callback server (SSRF/blind-injection oracle) ---
OOB_CALLBACK_DOMAIN=oob.localtest.me
OOB_CALLBACK_LISTEN_PORT=8888

# --- Scanner worker network policy ---
# Comma-separated CIDR/hosts the worker's egress guard additionally trusts
# beyond a target's own verified scope (e.g. our own control plane).
SCOPE_GUARD_ALLOW_EXTRA=

# --- Crawler / login-replay browser ---
# Leave unset in a normal environment that ran `playwright install
# chromium` — Playwright finds its own cached browser. Set only to force a
# specific Chromium binary (e.g. a sandbox with a pre-installed browser
# whose cached revision predates the installed playwright package).
SENTINEL_CHROMIUM_PATH=
