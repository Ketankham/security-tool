# Built from the repo root: docker build -f infra/docker/Dockerfile.worker .
FROM python:3.11-slim AS base

RUN apt-get update && apt-get install -y --no-install-recommends \
        curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.8.17 /uv /uvx /usr/local/bin/

WORKDIR /app

COPY pyproject.toml uv.lock ./
COPY apps/worker ./apps/worker
COPY packages ./packages

RUN uv sync --frozen --package sentinel-worker --no-dev

ENV PATH="/app/.venv/bin:${PATH}"

CMD ["celery", "-A", "sentinel_worker_app.celery_app", "worker", "--workdir", "apps/worker", "--loglevel", "INFO"]
