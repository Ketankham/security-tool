# Built from the repo root: docker build -f infra/docker/Dockerfile.worker .

# --- Recon binaries (ADR-0002: adopt MIT-licensed ProjectDiscovery tools) ----
# The recon phase shells out to these when present and degrades without them
# ("subfinder is not installed — subdomain discovery limited to the root
# domain"). Built from source with `go install` rather than downloading release
# zips: every module, and the Go toolchain itself, is then verified against
# Go's public checksum database, so a tampered download fails the build.
# Static (CGO off), so they run on the Debian-based runtime image below.
#
# Versions are pinned; bump them deliberately. tlsx needs Go >= 1.27.
#   subfinder v2.17.0 (2026-10-08) — passive subdomain enumeration
#   tlsx      v1.4.4  (2026-10-26) — TLS / cipher grading
#   httpx     v1.6.10            — HTTP probing + tech detection. Installed as
#             `pd-httpx`: the venv's Python `httpx` console script owns the
#             plain name on PATH (sentinel_recon/http_probe.py looks for pd-httpx).
FROM golang:1.27-bookworm AS recon-tools
ENV CGO_ENABLED=0 GOBIN=/out GOFLAGS=-trimpath
RUN go install github.com/projectdiscovery/subfinder/v2/cmd/subfinder@v2.17.0 \
    && go install github.com/projectdiscovery/tlsx/cmd/tlsx@v1.4.4 \
    && go install github.com/projectdiscovery/httpx/cmd/httpx@v1.6.10 \
    && mv /out/httpx /out/pd-httpx \
    && /out/subfinder -version \
    && /out/tlsx -version \
    && /out/pd-httpx -version

FROM python:3.11-slim AS base

RUN apt-get update && apt-get install -y --no-install-recommends \
        curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.8.17 /uv /uvx /usr/local/bin/

WORKDIR /app

COPY pyproject.toml uv.lock ./
COPY apps/worker ./apps/worker
COPY packages ./packages

RUN uv sync --frozen --package sentinel-worker --no-dev

ENV PATH="/app/.venv/bin:${PATH}"

COPY --from=recon-tools /out/subfinder /out/tlsx /out/pd-httpx /usr/local/bin/

# The AUTH_ESTABLISHING and CRAWLING phases drive a real browser
# (sentinel-auth / sentinel-crawler use Playwright). Install the Chromium
# revision matching the locked playwright package, plus its system libs, into
# a fixed path so it is found regardless of the worker's --workdir.
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
RUN playwright install --with-deps chromium \
    && rm -rf /var/lib/apt/lists/*

# --workdir is a global celery option: it must come before the subcommand.
# Scans plus login tests (the "logins" queue; see celery_app.py).
CMD ["celery", "--workdir", "apps/worker", "-A", "sentinel_worker_app.celery_app", "worker", "--loglevel", "INFO", "--queues", "celery,logins"]
